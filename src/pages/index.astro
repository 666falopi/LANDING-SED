<script>
  // This first version is local-only; do not submit form values or put them in a URL.
  document.querySelectorAll('.service-form').forEach(form => form.addEventListener('submit', event => event.preventDefault()));

  for (const gallery of document.querySelectorAll<HTMLElement>('.gallery')) {
    const track = gallery.querySelector<HTMLElement>('.gallery-track')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const prev = gallery.querySelector<HTMLButtonElement>('.gallery-prev')!;
    const next = gallery.querySelector<HTMLButtonElement>('.gallery-next')!;
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery-dot'));
    const counter = gallery.querySelector<HTMLElement>('.gallery-count')!;
    let active = 0;
    let target = 0;
    let navigating = false;
    const update = () => {
      if (!track.clientWidth) return;
      const position = Math.round(track.scrollLeft / track.clientWidth);
      active = Math.max(0, Math.min(slides.length - 1, position));
      counter.textContent = String(active + 1).padStart(2, '0') + ' / ' + String(slides.length).padStart(2, '0');
      prev.disabled = slides.length < 2;
      next.disabled = slides.length < 2;
      dots.forEach((dot, index) => index === active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current'));
    };
    const go = (index: number) => {
      const wraps = index < 0 || index >= slides.length;
      target = ((index % slides.length) + slides.length) % slides.length;
      navigating = true;
      track.scrollTo({left: target * track.clientWidth, behavior: wraps || matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
    };
    prev.addEventListener('click', () => go((navigating ? target : active) - 1));
    next.addEventListener('click', () => go((navigating ? target : active) + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));
    track.addEventListener('scroll', update, {passive: true});
    track.addEventListener('scrollend', () => {navigating = false; update();});
    track.addEventListener('pointerdown', () => {navigating = false;});
    track.addEventListener('wheel', () => {navigating = false;}, {passive:true});
    track.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const current = navigating ? target : active;
      go(event.key === 'Home' ? 0 : event.key === 'End' ? slides.length - 1 : current + (event.key === 'ArrowRight' ? 1 : -1));
    });
    new ResizeObserver(() => {if (!track.clientWidth) return; track.scrollTo({left:active * track.clientWidth,behavior:'instant'}); navigating=false;}).observe(track);
    update();
  }

  const selector = document.querySelector<HTMLSelectElement>('#section-select')!;
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.service-section'));
  const selectSection = (id: string) => {
    if (!panels.some(panel => panel.dataset.section === id)) return;
    panels.forEach(panel => {panel.hidden = panel.dataset.section !== id;});
    selector.value = id;
  };
  selector.addEventListener('change', () => {
    selectSection(selector.value);
    history.replaceState(null, '', '#' + selector.value);
  });
  window.addEventListener('hashchange', () => selectSection(location.hash.slice(1)));
  selectSection(location.hash.slice(1));
</script>
