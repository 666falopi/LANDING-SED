  /* Brand color sampled directly from the supplied SED artwork. */
  :global(:root){--brand:#2d2dc9;--paper:#f6f6f2}
  .sheet{height:100dvh;min-height:0}
  .rail{min-height:0;padding:16px 12px;gap:14px;overflow:hidden}
  .wordmark{display:flex;flex-direction:column;align-items:center;gap:9px;background:white;padding:8px 10px 12px;width:100%;max-width:116px;flex-shrink:0}
  .wordmark strong{position:relative;font:inherit}
  .brand-symbol{width:100%;height:auto;display:block;max-height:100px;object-fit:contain}
  .vertical{background:#ffffff;padding:12px 7px;margin:0;font-size:clamp(21px,4.8dvh,43px)}
  .rail-arrow{background:#ffffff;padding:7px;flex-shrink:0;max-height:70px}
  .rail-arrow svg{display:block;width:100%;height:100%}
  thead{background:#e7e7f3;color:var(--brand)}
  .skip{background:white;color:var(--brand)}
  :global(::selection){background:#dadaff;color:var(--brand)}
  @media(min-width:1001px){
    main{height:100dvh;display:grid;grid-template-rows:clamp(38px,7dvh,58px) minmax(0,1fr)}
    .masthead{height:100%}
    .columns{height:100%;min-height:0}
    .editorial{min-height:0;display:grid;grid-template-rows:40% 26% 34%}
    .intro{padding:clamp(14px,3.6dvh,36px) 27px 12px;min-height:0}
    h1{font-size:clamp(38px,min(5.45vw,9.5dvh),94px);margin-bottom:clamp(12px,3dvh,29px)}
    .intro-copy{font-size:clamp(9px,1.45dvh,13px);line-height:1.6;max-width:60ch}
    .features article{padding:clamp(12px,3.2dvh,30px) 27px 12px}
    .features h2{font-size:clamp(26px,min(3.1vw,5.5dvh),53px);margin:8px 0}
    .features p{font-size:clamp(9px,1.4dvh,12px)}
    .eyebrow{font-size:clamp(8px,1.35dvh,10px)}
    .specs{padding:clamp(12px,2.8dvh,26px) 27px 10px;min-height:0}
    td,th{padding:clamp(2px,.55dvh,7px) 0}
    thead th{padding:clamp(4px,.9dvh,8px) 10px}
    .table-footer{margin-top:clamp(6px,1.2dvh,16px)}
    .technical{min-height:0;height:100%}
    .diagram-heading{margin-top:clamp(18px,3.8dvh,31px)}
    .diagram-heading h2{font-size:clamp(20px,min(2.15vw,4dvh),37px)}
    .robot-figure{inset:13% 12% 8% 14%}
    .wrist{top:22%}.arm{top:24%}
    .diagram-bottom{bottom:18px}
    .diagram-bottom p{font-size:clamp(22px,min(2.4vw,4.4dvh),40px)}
  }
  @media(max-width:1000px){
    .sheet{height:auto;min-height:100dvh;align-items:stretch} main{height:auto;overflow:visible;min-height:0} .columns{min-height:0}
    .vertical{position:static;font-size:26px}
    .wordmark{font-size:32px;padding:6px 5px 9px}
    .wordmark span{right:-6px;font-size:7px}
    .rail{gap:20px;justify-content:space-between}
    .rail-arrow{margin-top:0}
  }
  @media(max-width:560px){
    .sheet{display:block;height:auto;min-height:100dvh;grid-template-columns:none;grid-template-rows:none}
    .rail{height:106px;padding:8px 20px;overflow:visible}
    main{height:auto;min-height:0;overflow:visible}
    .wordmark{width:62px;font-size:24px;gap:3px;padding:4px 8px 6px}
    .brand-symbol{max-height:46px}
    .vertical{font-size:12px;padding:8px 10px;max-width:150px}
    .rail-arrow{width:40px;padding:5px}
  }
</style>

<style>
  .gallery{min-width:0;min-height:0;display:grid;grid-template-rows:minmax(0,1fr) 53px;overflow:hidden}
  .gallery-track{display:flex;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;overscroll-behavior-x:contain;min-height:0;outline-offset:-3px}
  .gallery-track::-webkit-scrollbar{display:none}
  .gallery-slide{flex:0 0 100%;width:100%;height:100%;min-height:0;scroll-snap-align:start;scroll-snap-stop:always}
  .gallery-nav{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 27px;border-top:1px solid #8b8c85;color:var(--brand);background:var(--paper)}
  .gallery-count{font:10px 'IBM Plex Mono',monospace;letter-spacing:.07em;min-width:65px}
  .gallery-dots,.gallery-arrows{display:flex;align-items:center;gap:5px}
  .gallery-nav button{color:var(--brand);background:transparent;border:0;cursor:pointer;display:grid;place-items:center;min-width:40px;min-height:40px;padding:0}
  .gallery-dot span{display:block;width:6px;height:6px;border:1px solid currentColor;border-radius:50%;transition:background .15s,transform .15s}
  .gallery-dot[aria-current="true"] span{background:currentColor;transform:scale(1.3)}
  .gallery-arrows{gap:8px}.gallery-arrows button{font:28px/1 Inter,sans-serif}
  .gallery-nav button:hover:not(:disabled){background:#e7e7f3}
  .gallery-nav button:focus-visible,.gallery-track:focus-visible{outline:2px solid var(--brand);outline-offset:-3px}
  .gallery-nav button:disabled{opacity:.25;cursor:default}
  @media(max-width:1000px){.gallery{height:760px}.gallery .technical{min-height:0}}
  @media(max-width:560px){.gallery{height:680px}.gallery-nav{padding:0 20px}.gallery-dots{gap:0}.gallery-dot{min-width:30px!important}}
  @media(prefers-reduced-motion:reduce){.gallery-dot span{transition:none}}
</style>
<script>
  const gallery = document.querySelector<HTMLElement>('.gallery');
  if (gallery) {
    const track = gallery.querySelector<HTMLElement>('.gallery-track')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const prev = gallery.querySelector<HTMLButtonElement>('.gallery-prev')!;
    const next = gallery.querySelector<HTMLButtonElement>('.gallery-next')!;
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.gallery-dot'));
    const counter = gallery.querySelector<HTMLElement>('.gallery-count')!;
    let active = 0;
    let target = 0;
    let navigating = false;
    const update = () => {
      const position = Math.round(track.scrollLeft / track.clientWidth);
      active = Math.max(0, Math.min(slides.length - 1, position));
      counter.textContent = String(active + 1).padStart(2, '0') + ' / 04';
      prev.disabled = active === 0;
      next.disabled = active === slides.length - 1;
      dots.forEach((dot, index) => index === active ? dot.setAttribute('aria-current', 'true') : dot.removeAttribute('aria-current'));
    };
    const go = (index: number) => {
      target = Math.max(0, Math.min(slides.length - 1, index));
      navigating = true;
      track.scrollTo({left: target * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
    };
    prev.addEventListener('click', () => go((navigating ? target : active) - 1));
    next.addEventListener('click', () => go((navigating ? target : active) + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));
    track.addEventListener('scroll', update, {passive: true});
    track.addEventListener('scrollend', () => {navigating = false; update();});
    track.addEventListener('pointerdown', () => {navigating = false;});
    track.addEventListener('wheel', () => {navigating = false;}, {passive:true});
    track.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const current = navigating ? target : active;
      go(event.key === 'Home' ? 0 : event.key === 'End' ? slides.length - 1 : current + (event.key === 'ArrowRight' ? 1 : -1));
    });
    new ResizeObserver(() => {track.scrollTo({left:active * track.clientWidth,behavior:'instant'}); navigating=false;}).observe(track);
    update();
  }
</script>
